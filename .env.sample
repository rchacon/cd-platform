# Get a free key at https://api.congress.gov
CONGRESS_API_KEY=

# Shared across every Airflow component service in docker-compose.yml (see
# AGENTS.md) -- must be identical everywhere, since these sign/verify the
# Execution API's JWTs, encrypt/decrypt stored Connection passwords, and
# sign api-server's session cookies, respectively. Generate once per
# environment, not per component.
#   openssl rand -hex 32
AIRFLOW__API_AUTH__JWT_SECRET=
#   python3 -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
AIRFLOW__CORE__FERNET_KEY=
#   openssl rand -hex 32
AIRFLOW__API__SECRET_KEY=
