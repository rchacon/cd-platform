# Get a free key at https://api.congress.gov
CONGRESS_API_KEY=

# Airflow UI admin login (http://localhost:8080). Defaults to "admin" via
# docker-compose.yml if left unset here -- override for a stronger local
# password.
AIRFLOW_ADMIN_PASSWORD=

# Cognito ID-token verification (cd-server). All three optional for local
# dev -- unset disables JWT verification entirely (see cd-server/src/cd/
# server/services/users_service.py), so `make start-server` still works
# with zero AWS setup. Set all three (from cd-infra's Terraform outputs:
# cognito_user_pool_id, var.aws_region, cognito_user_pool_client_id +
# cognito_dev_client_id, comma-separated) to exercise the real
# upsert-into-cd_customers path locally.
COGNITO_USER_POOL_ID=
COGNITO_REGION=
COGNITO_CLIENT_IDS=

# Bedrock (cd-etl's bills_common.sync_bill(), cd-platform#9). All
# optional for local dev -- a missing/invalid/under-permissioned set
# degrades to "no embedding this sync" rather than failing the DAG (see
# docker-compose.yml's cd-etl service). Set from your own AWS
# credentials to exercise real embedding generation locally; the
# identity used needs bedrock:InvokeModel on
# amazon.titan-embed-text-v2:0 (production's own grant lives in
# cd-infra's airflow-ecs task role, unrelated to whatever you use here).
# Leave AWS_SESSION_TOKEN unset for a long-lived access key pair --
# only needed for temporary credentials (e.g. an SSO session export).
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_SESSION_TOKEN=
AWS_REGION=
