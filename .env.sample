# Get a free key at https://api.congress.gov
CONGRESS_API_KEY=

# Airflow UI admin login (http://localhost:8080). Defaults to "admin" via
# docker-compose.yml if left unset here -- override for a stronger local
# password.
AIRFLOW_ADMIN_PASSWORD=

# Cognito ID-token verification (cd-server). All three optional for local
# dev -- unset disables JWT verification entirely (see cd-server/src/cd/
# server/services/users_service.py), so `make start-server` still works
# with zero AWS setup. Set all three (from cd-infra's Terraform outputs:
# cognito_user_pool_id, var.aws_region, cognito_user_pool_client_id +
# cognito_dev_client_id, comma-separated) to exercise the real
# upsert-into-cd_customers path locally.
COGNITO_USER_POOL_ID=
COGNITO_REGION=
COGNITO_CLIENT_IDS=

# Bedrock -- shared by cd-etl's bills_common.sync_bill() (Titan Text
# Embeddings V2, cd-platform#9) and cd-server's summarizeVotingRecord
# mutation (Anthropic Claude via the Converse API). Optional for local
# dev: a missing/invalid setup degrades to "no embedding this sync" for
# cd-etl (see docker-compose.yml's cd-etl service), and for cd-server
# just makes summarizeVotingRecord fail if invoked -- neither breaks
# `make start-etl` / `make start-server`.
#
# AWS_PROFILE names a profile in your own ~/.aws/config that assumes a
# small, purpose-built IAM role holding the needed bedrock:InvokeModel
# grant -- NOT a profile whose own long-lived user directly holds it.
# e.g.:
#
#   [profile local-bedrock]
#   role_arn = arn:aws:iam::<account-id>:role/cd-platform-local-bedrock-dev
#   source_profile = default
#   region = us-west-2
#
# where cd-platform-local-bedrock-dev's trust policy allows your own
# IAM user/group to assume it. This mirrors production's own shape
# (temporary, auto-rotated credentials via the ECS task role -- see
# cd-infra's task roles) rather than a static secret with a standing
# grant. docker-compose.yml mounts ~/.aws read-only into both containers
# so boto3 there resolves this the same way it does on the host.
AWS_PROFILE=
AWS_REGION=

# cd-server only: a Bedrock cross-region inference profile id (the
# "us."-prefixed form) for the Claude model summarizeVotingRecord calls.
# No default -- depends on what model access is granted in the account
# you're pointing at (cd-infra#69). Leave blank unless you're actually
# exercising that mutation locally.
BEDROCK_CHAT_MODEL_ID=
